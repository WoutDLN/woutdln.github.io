{% assign eventdates = page.eventdate | split: "/" %}
{% assign fromdate = eventdates | first %}
    {% assign fromdate_year = fromdate | slice: -2, 2 %}
    {% assign fromdate_monthyear = fromdate | slice -5, 5 %}
{% assign todate = eventdates | last %}
    {% assign todate_year = todate | slice: -2, 2 %}
    {% assign todate_monthyear = todate | slice -5, 5 %}

{% capture talk_intro %}
<div>
    <p>
     This talk was presented 
        by <strong>{{ page.author }}</strong> 
        at <strong>{{ page.eventtitle | append: ": " | append: page.eventtitleaddon }}</strong>
        {% if page.date and page.date != page.eventdate %} 
            on <strong>{{ page.date | date: "%A %e %B %Y" }}</strong>{% endif %}. 
     This event took place 
        in <strong>{{ page.location }}</strong>, 
        at the <strong>{{ page.venue }}</strong>,
            {% if eventdates.size == 1 %}on <strong>{{ page.eventdate }}</strong>{% endif %}
            {% if eventdates.size > 1 %}from <strong>
                {% if fromdate_monthyear == todate_monthyear %}
                    {{ fromdate | date: "%e" }}
                {% elsif fromdate_year == todate_year %}
                    {{ fromdate | date : "%e %B" }}
                {% else %}
                    {{ fromdate | date : "%e %B %Y" }}
                {% endif %}
            </strong> to <strong>{{ todate | date : "%e %B %Y" }}</strong>{% endif %}. 
    </p>
</div>
{% if page.eventurl or page.programmeurl or page.pdf %}
<div>
    <p>
        <strong>Links:</strong>
        {% if page.eventurl %}
            <a href="{{ page.eventurl }}">Event Website{% if page.eventurl contains "web.archive.org" %} <i class="fa fa-archive" aria-hidden="true" title="Link archived using the web archive"></i>{% endif %}</a>
        {% endif %}
        {% if page.eventurl and page.programmeurl or page.pdf %} | {% endif %}
        {% if page.programmeurl %}
            <a href="{{ page.programmeurl }}">Programme{% if page.programmeurl contains "web.archive.org" %} <i class="fa fa-archive" aria-hidden="true" title="Link archived using the web archive"></i>{% endif %}</a>
        {% endif %}
        {% if page.programmeurl and page.pdf %} | {% endif %}
        {% if page.pdf %}
            <a href="{{ page.pdf }}">Slides <i class="fa fa-file-pdf" aria-hidden="true" title="PDF of slides to the presentation"></i></a>
        {% endif %}
    </p>
</div>
{% endif %}
{% endcapture %}
{{ talk_intro }}